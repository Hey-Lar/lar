# Lar portal — copy to .env.local and fill in. NEVER commit real values.
# See docs/11-secrets-and-env.md for the full env contract and rotation guidance.

# Server-only (never prefix NEXT_PUBLIC_). Optional in dev — the portal runs
# without these; missing values fall back to demo data or the keyless path.

# Base URL for the Lumina finance API (read-only aggregation).
# When set, /api/finance returns a live snapshot; otherwise returns demo data.
LUMINA_API_BASE=

# Anthropic API key for cloud intent escalation in /api/lar.
# Used only when the deterministic parser returns low confidence.
# Never expose this key client-side.
LAR_ANTHROPIC_KEY=

# --- Supabase auth + sync (OPTIONAL) ---------------------------------------
# Leave BOTH blank and the app stays fully keyless/local-first — auth + sync
# are inert. Set BOTH to arm cross-device sync. These are browser-safe (RLS is
# on); they are NOT secrets. Find them in Supabase → Project Settings → API.
# See docs/20-auth.md for the full step-by-step.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
