# dependencies
node_modules/
.pnp/
.pnp.js

# transient build/agent artifacts
.tmp-*
.tmp/

# env / secrets
.env
.env.*
*.local
secrets/
*.key
*.pem

# secrets / credentials (hardened)
# Enterprise, Android, TLS, and cloud credential file types.
# Re-include exceptions below keep example/template files committable.
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
*.crt
*.cer
*-service-account*.json
*credentials*.json
*.secret
*token*.json

# Re-include example / template files that match the patterns above.
!.env.example
!**/.env.example
!*.template.*
!**/*.template.*

# build output
dist/
build/
.next/
out/
.vercel/

# logs
*.log
npm-debug.log*
yarn-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# turbo
.turbo/

# test / coverage
coverage/

# typescript incremental build info
*.tsbuildinfo
