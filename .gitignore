# dependencies
node_modules/
.pnp/
.pnp.js

# transient build/agent artifacts
.tmp-*
.tmp/

# env / secrets
.env
.env.*
*.local
secrets/
*.key
*.pem

# secrets / credentials (hardened)
# Enterprise, Android, TLS, and cloud credential file types.
# Re-include exceptions below keep example/template files committable.
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
*.crt
*.cer
*-service-account*.json
*credentials*.json
*.secret
*token*.json

# Re-include example / template files that match the patterns above.
!.env.example
!**/.env.example
!*.template.*
!**/*.template.*

# build output
dist/
build/
.next/
out/
.vercel/

# logs
*.log
npm-debug.log*
yarn-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# turbo
.turbo/

# Local-only bundled assets (real background photos, etc.) — never committed
# (privacy). The dir + its README are kept; everything else is ignored.
apps/portal/public/local/*
!apps/portal/public/local/
!apps/portal/public/local/README.md

# test / coverage
coverage/

# typescript incremental build info
*.tsbuildinfo

# Lar: generated surfaces that embed REAL finance figures — never committed.
# Rebuild locally: prototype/sync-wealth.mjs (needs ~/Documents/Claude/net-worth)
# and apps/lar-ios/embed.mjs.
prototype/index.html
apps/lar-ios/Web/
apps/lar-ios/LarApp.xcodeproj/
prototype/move-data.js
